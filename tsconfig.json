{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "lib",
    "outDir": ".tsbuild",
    "declaration": true,
    "sourceMap": true,
    "noEmitOnError": true,
    "strict": false,
    "noImplicitAny": true,
    "skipLibCheck": true
  },
  "include": ["lib/**/*.ts"]
}
