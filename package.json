{
  "name": "@danielgindi/dom-utils",
  "version": "2.0.3",
  "description": "A collection of dom utilities. So you can work natively with the dom without dom frameworks.",
  "main": "dist/lib.cjs.min.js",
  "module": "lib/index.js",
  "browser": "dist/lib.umd.min.js",
  "types": "dist/types/index.d.ts",
  "author": "Daniel Cohen Gindi <danielgindi@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git://github.com/danielgindi/dom-utils.git"
  },
  "directories": {
    "dist": "dist",
    "lib": "lib"
  },
  "scripts": {
    "build": "npm run lint && npm run typecheck && tsc && tsx ./scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.scripts.json --noEmit && tsc --project tsconfig.tests.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:package": "npm run build && tsx --test tests/package/*.test.ts",
    "lint": "eslint -f codeframe ./",
    "lint-fix": "eslint -f codeframe --fix ./",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "bugs": {
    "url": "https://github.com/danielgindi/dom-utils/issues"
  },
  "homepage": "https://github.com/danielgindi/dom-utils#readme",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/runtime": "^7.29.15",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "babelify": "^10.0.0",
    "core-js": "^3.51.0",
    "eslint": "^10.15.0",
    "eslint-formatter-codeframe": "^7.32.2",
    "fs-extra": "^11.4.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "pinst": "^3.0.0",
    "rollup": "^4.68.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
